@model IEnumerable<AspNetCore8Test.Models.FinanceModels.ConstructionEquipmentFinance>
@{
    ViewData["Title"] = "營建機具分期業務";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h3 mb-0 text-gray-800">
                    <i class="fas fa-hard-hat text-warning me-2"></i>營建機具分期業務管理
                </h1>
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a asp-controller="Home" asp-action="Index">首頁</a>
                    </li>
                    <li class="breadcrumb-item">
                        <a asp-controller="Finance" asp-action="Index">融資租賃管理</a>
                    </li>
                    <li class="breadcrumb-item active">營建機具分期</li>
                </ol>
            </div>
        </div>
    </div>

    <!-- 統計卡片 -->
    <div class="row mb-4">
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-warning shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                                營建機具總額
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">NT$ 97,000,000</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-hard-hat fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-success shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                                活躍合約數
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">2</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-file-contract fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-info shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-info text-uppercase mb-1">
                                本月收款
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">NT$ 270,000</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-dollar-sign fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                                平均貸款期數
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">45 個月</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-calendar-alt fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 營建機具分期清單 -->
    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-warning">營建機具分期清單</h6>
            <div>
                <button class="btn btn-warning btn-sm me-2">
                    <i class="fas fa-plus me-1"></i>新增分期
                </button>
                <button class="btn btn-success btn-sm">
                    <i class="fas fa-file-excel me-1"></i>匯出Excel
                </button>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>編號</th>
                            <th>客戶名稱</th>
                            <th>機具類型</th>
                            <th>品牌/型號</th>
                            <th>貸款金額</th>
                            <th>月付金</th>
                            <th>貸款期數</th>
                            <th>狀態</th>
                            <th>申請日期</th>
                            <th>下次繳款日</th>
                            <th>操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td>
                                    <strong>@item.CustomerName</strong>
                                </td>
                                <td>
                                    <span class="badge bg-warning text-dark">@item.EquipmentType</span>
                                </td>
                                <td>
                                    <div>
                                        <strong>@item.Brand</strong><br>
                                        <small class="text-muted">@item.Model</small>
                                    </div>
                                </td>
                                <td class="text-end">
                                    <strong>NT$ @item.LoanAmount.ToString("N0")</strong>
                                </td>
                                <td class="text-end">
                                    NT$ @item.MonthlyPayment.ToString("N0")
                                </td>
                                <td class="text-center">
                                    @item.LoanPeriod 個月
                                </td>
                                <td>
                                    @if (item.Status == "正常繳費")
                                    {
                                        <span class="badge bg-success">@item.Status</span>
                                    }
                                    else if (item.Status == "逾期")
                                    {
                                        <span class="badge bg-danger">@item.Status</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">@item.Status</span>
                                    }
                                </td>
                                <td>@item.ApplicationDate.ToString("yyyy/MM/dd")</td>
                                <td>
                                    @if (item.NextPaymentDate < DateTime.Now)
                                    {
                                        <span class="text-danger">
                                            <i class="fas fa-exclamation-triangle me-1"></i>
                                            @item.NextPaymentDate.ToString("yyyy/MM/dd")
                                        </span>
                                    }
                                    else
                                    {
                                        <span>@item.NextPaymentDate.ToString("yyyy/MM/dd")</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group">
                                        <button type="button" class="btn btn-sm btn-outline-primary" 
                                                onclick="viewDetails(@item.Id)" title="查看詳細">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-success" 
                                                onclick="makePayment(@item.Id)" title="繳款記錄">
                                            <i class="fas fa-dollar-sign"></i>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-warning" 
                                                onclick="editContract(@item.Id)" title="編輯">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-info" 
                                                onclick="viewEquipment(@item.Id)" title="設備詳情">
                                            <i class="fas fa-hard-hat"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- 圖表區域 -->
    <div class="row">
        <div class="col-lg-6">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-warning">機具類型分布</h6>
                </div>
                <div class="card-body">
                    <canvas id="equipmentTypeChart"></canvas>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-warning">品牌分布</h6>
                </div>
                <div class="card-body">
                    <canvas id="brandChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- 設備維護提醒 -->
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-info">
                <i class="fas fa-tools me-2"></i>設備維護提醒
            </h6>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-lg-4 mb-3">
                    <div class="alert alert-warning">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        <strong>Caterpillar 320D</strong><br>
                        <small>預計保養日期：2024/10/15</small>
                    </div>
                </div>
                <div class="col-lg-4 mb-3">
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle me-2"></i>
                        <strong>Komatsu D65EX</strong><br>
                        <small>上次保養：2024/08/20</small>
                    </div>
                </div>
                <div class="col-lg-4 mb-3">
                    <div class="alert alert-success">
                        <i class="fas fa-check-circle me-2"></i>
                        <strong>設備運行正常</strong><br>
                        <small>無需立即維護</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .border-left-primary {
        border-left: 0.25rem solid #4e73df !important;
    }
    .border-left-success {
        border-left: 0.25rem solid #1cc88a !important;
    }
    .border-left-info {
        border-left: 0.25rem solid #36b9cc !important;
    }
    .border-left-warning {
        border-left: 0.25rem solid #f6c23e !important;
    }
    
    .table th {
        background-color: #f8f9fc;
        border-color: #e3e6f0;
        color: #5a5c69;
        font-weight: 700;
        text-transform: uppercase;
        font-size: 0.75rem;
    }
    
    .table-hover tbody tr:hover {
        background-color: rgba(246, 194, 62, 0.05);
    }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // 機具類型分布圖表
        const equipmentTypeCtx = document.getElementById('equipmentTypeChart').getContext('2d');
        const equipmentTypeChart = new Chart(equipmentTypeCtx, {
            type: 'doughnut',
            data: {
                labels: ['挖土機', '推土機', '起重機', '壓路機'],
                datasets: [{
                    data: [1, 1, 0, 0],
                    backgroundColor: [
                        '#f6c23e',
                        '#fd7e14',
                        '#6f42c1',
                        '#20c997'
                    ]
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom'
                    }
                }
            }
        });

        // 品牌分布圖表
        const brandCtx = document.getElementById('brandChart').getContext('2d');
        const brandChart = new Chart(brandCtx, {
            type: 'bar',
            data: {
                labels: ['Caterpillar', 'Komatsu', 'Hitachi', 'Volvo'],
                datasets: [{
                    label: '設備數量',
                    data: [1, 1, 0, 0],
                    backgroundColor: '#f6c23e',
                    borderColor: '#d1a64b',
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: {
                        beginAtZero: true
                    }
                }
            }
        });

        // 功能按鈕事件
        function viewDetails(id) {
            alert('查看營建機具詳細資料 ID: ' + id);
        }

        function makePayment(id) {
            alert('處理繳款記錄 ID: ' + id);
        }

        function editContract(id) {
            alert('編輯合約 ID: ' + id);
        }

        function viewEquipment(id) {
            alert('查看設備詳情 ID: ' + id);
        }
    </script>
}