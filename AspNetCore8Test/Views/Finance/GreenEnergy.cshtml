@model IEnumerable<AspNetCore8Test.Models.FinanceModels.GreenEnergyFinance>
@{
    ViewData["Title"] = "綠能融資專案";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h3 mb-0 text-gray-800">
                    <i class="fas fa-leaf text-success me-2"></i>綠能融資專案管理
                </h1>
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a asp-controller="Home" asp-action="Index">首頁</a>
                    </li>
                    <li class="breadcrumb-item">
                        <a asp-controller="Finance" asp-action="Index">融資租賃管理</a>
                    </li>
                    <li class="breadcrumb-item active">綠能融資</li>
                </ol>
            </div>
        </div>
    </div>

    <!-- ESG 與永續發展指標 -->
    <div class="alert alert-success border-left-success mb-4">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <h5 class="alert-heading">
                    <i class="fas fa-globe-asia me-2"></i>ESG 永續發展貢獻
                </h5>
                <p class="mb-0">
                    支持綠能產業發展，響應政府2050淨零排放目標，累計減碳效益達 <strong>1,286.1 噸CO2</strong>
                </p>
            </div>
            <div class="col-lg-4 text-end">
                <button class="btn btn-success btn-sm">
                    <i class="fas fa-download me-1"></i>ESG報告書
                </button>
            </div>
        </div>
    </div>

    <!-- 統計卡片 -->
    <div class="row mb-4">
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-success shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                                綠能融資總額
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">NT$ 510,000,000</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-leaf fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-info shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-info text-uppercase mb-1">
                                活躍專案數
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">2</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-solar-panel fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-warning shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                                年減碳量(噸)
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">1,286.1</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-cloud fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                                總裝置容量
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">2.1MW</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-bolt fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 綠能融資專案清單 -->
    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-success">綠能融資專案清單</h6>
            <div>
                <button class="btn btn-success btn-sm me-2">
                    <i class="fas fa-plus me-1"></i>新增專案
                </button>
                <div class="btn-group">
                    <button type="button" class="btn btn-outline-success btn-sm dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="fas fa-filter me-1"></i>專案類型
                    </button>
                    <ul class="dropdown-menu">
                        <li><button class="dropdown-item" onclick="filterByType('all')">全部專案</button></li>
                        <li><button class="dropdown-item" onclick="filterByType('solar')">太陽能發電</button></li>
                        <li><button class="dropdown-item" onclick="filterByType('wind')">風力發電</button></li>
                        <li><button class="dropdown-item" onclick="filterByType('storage')">儲能系統</button></li>
                    </ul>
                </div>
                <button class="btn btn-info btn-sm">
                    <i class="fas fa-file-excel me-1"></i>匯出Excel
                </button>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>編號</th>
                            <th>客戶名稱</th>
                            <th>專案類型</th>
                            <th>裝置容量</th>
                            <th>融資金額</th>
                            <th>月付金</th>
                            <th>融資期數</th>
                            <th>年減碳量</th>
                            <th>狀態</th>
                            <th>申請日期</th>
                            <th>下次繳款日</th>
                            <th>操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td>
                                    <strong>@item.CustomerName</strong>
                                    <br><small class="text-muted">綠能產業</small>
                                </td>
                                <td>
                                    @if (item.ProjectType.Contains("太陽能"))
                                    {
                                        <span class="badge bg-warning text-dark">
                                            <i class="fas fa-sun me-1"></i>@item.ProjectType
                                        </span>
                                    }
                                    else if (item.ProjectType.Contains("風力"))
                                    {
                                        <span class="badge bg-info">
                                            <i class="fas fa-wind me-1"></i>@item.ProjectType
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">@item.ProjectType</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <strong>@item.Capacity</strong>
                                </td>
                                <td class="text-end">
                                    <strong>NT$ @item.LoanAmount.ToString("N0")</strong>
                                </td>
                                <td class="text-end">
                                    NT$ @item.MonthlyPayment.ToString("N0")
                                </td>
                                <td class="text-center">
                                    @item.LoanPeriod 個月
                                </td>
                                <td class="text-center">
                                    <span class="text-success">
                                        <i class="fas fa-leaf me-1"></i>@item.CarbonReduction.ToString("N1") 噸
                                    </span>
                                </td>
                                <td>
                                    @if (item.Status == "正常繳費")
                                    {
                                        <span class="badge bg-success">@item.Status</span>
                                    }
                                    else if (item.Status == "逾期")
                                    {
                                        <span class="badge bg-danger">@item.Status</span>
                                    }
                                    else if (item.Status == "審核中")
                                    {
                                        <span class="badge bg-warning text-dark">@item.Status</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@item.Status</span>
                                    }
                                </td>
                                <td>@item.ApplicationDate.ToString("yyyy/MM/dd")</td>
                                <td>
                                    @if (item.Status == "審核中")
                                    {
                                        <span class="text-muted">待審核</span>
                                    }
                                    else if (item.NextPaymentDate < DateTime.Now)
                                    {
                                        <span class="text-danger">
                                            <i class="fas fa-exclamation-triangle me-1"></i>
                                            @item.NextPaymentDate.ToString("yyyy/MM/dd")
                                        </span>
                                    }
                                    else
                                    {
                                        <span>@item.NextPaymentDate.ToString("yyyy/MM/dd")</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group">
                                        <button type="button" class="btn btn-sm btn-outline-primary" 
                                                onclick="viewDetails(@item.Id)" title="查看詳細">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-success" 
                                                onclick="viewESGReport(@item.Id)" title="ESG報告">
                                            <i class="fas fa-leaf"></i>
                                        </button>
                                        @if (item.Status != "審核中")
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-warning" 
                                                    onclick="makePayment(@item.Id)" title="繳款記錄">
                                                <i class="fas fa-dollar-sign"></i>
                                            </button>
                                        }
                                        <button type="button" class="btn btn-sm btn-outline-info" 
                                                onclick="viewPerformance(@item.Id)" title="發電績效">
                                            <i class="fas fa-chart-line"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- 圖表和分析 -->
    <div class="row">
        <div class="col-lg-6">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-success">綠能類型分布</h6>
                </div>
                <div class="card-body">
                    <canvas id="energyTypeChart"></canvas>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-success">月度減碳效益</h6>
                </div>
                <div class="card-body">
                    <canvas id="carbonReductionChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- 政府政策與補助資訊 -->
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-info">
                <i class="fas fa-info-circle me-2"></i>政府綠能政策與補助資訊
            </h6>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-lg-4 mb-3">
                    <div class="alert alert-info">
                        <h6><i class="fas fa-hand-holding-usd me-2"></i>投資抵減</h6>
                        <p class="mb-1">購置再生能源發電設備</p>
                        <small>可享5%投資抵減優惠</small>
                    </div>
                </div>
                <div class="col-lg-4 mb-3">
                    <div class="alert alert-success">
                        <h6><i class="fas fa-certificate me-2"></i>綠電憑證</h6>
                        <p class="mb-1">再生能源憑證制度</p>
                        <small>每度電可申請憑證</small>
                    </div>
                </div>
                <div class="col-lg-4 mb-3">
                    <div class="alert alert-warning">
                        <h6><i class="fas fa-coins me-2"></i>躉購費率</h6>
                        <p class="mb-1">2024年太陽光電躉購費率</p>
                        <small>屋頂型：3.79-4.27元/度</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .border-left-primary {
        border-left: 0.25rem solid #4e73df !important;
    }
    .border-left-success {
        border-left: 0.25rem solid #1cc88a !important;
    }
    .border-left-info {
        border-left: 0.25rem solid #36b9cc !important;
    }
    .border-left-warning {
        border-left: 0.25rem solid #f6c23e !important;
    }
    
    .table th {
        background-color: #f8f9fc;
        border-color: #e3e6f0;
        color: #5a5c69;
        font-weight: 700;
        text-transform: uppercase;
        font-size: 0.75rem;
    }
    
    .table-hover tbody tr:hover {
        background-color: rgba(28, 200, 138, 0.05);
    }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // 綠能類型分布圖表
        const energyTypeCtx = document.getElementById('energyTypeChart').getContext('2d');
        const energyTypeChart = new Chart(energyTypeCtx, {
            type: 'doughnut',
            data: {
                labels: ['太陽能發電', '風力發電', '儲能系統', '生質能'],
                datasets: [{
                    data: [1, 1, 0, 0],
                    backgroundColor: [
                        '#f6c23e',
                        '#36b9cc',
                        '#1cc88a',
                        '#6f42c1'
                    ]
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom'
                    }
                }
            }
        });

        // 月度減碳效益圖表
        const carbonReductionCtx = document.getElementById('carbonReductionChart').getContext('2d');
        const carbonReductionChart = new Chart(carbonReductionCtx, {
            type: 'line',
            data: {
                labels: ['1月', '2月', '3月', '4月', '5月', '6月'],
                datasets: [{
                    label: '減碳量(噸CO2)',
                    data: [180, 190, 210, 195, 230, 215],
                    borderColor: '#1cc88a',
                    backgroundColor: 'rgba(28, 200, 138, 0.1)',
                    borderWidth: 2,
                    fill: true
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function(value) {
                                return value + ' 噸';
                            }
                        }
                    }
                }
            }
        });

        // 功能按鈕事件
        function viewDetails(id) {
            alert('查看綠能專案詳細資料 ID: ' + id);
        }

        function viewESGReport(id) {
            alert('查看ESG報告 ID: ' + id);
        }

        function makePayment(id) {
            alert('處理繳款記錄 ID: ' + id);
        }

        function viewPerformance(id) {
            alert('查看發電績效 ID: ' + id);
        }

        function filterByType(type) {
            console.log('篩選類型:', type);
            // 這裡可以實作篩選邏輯
        }
    </script>
}