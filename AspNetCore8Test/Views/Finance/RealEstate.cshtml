@model IEnumerable<AspNetCore8Test.Models.FinanceModels.RealEstateLease>
@{
    ViewData["Title"] = "不動產租賃業務";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h3 mb-0 text-gray-800">
                    <i class="fas fa-building text-dark me-2"></i>不動產租賃業務管理
                </h1>
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a asp-controller="Home" asp-action="Index">首頁</a>
                    </li>
                    <li class="breadcrumb-item">
                        <a asp-controller="Finance" asp-action="Index">融資租賃管理</a>
                    </li>
                    <li class="breadcrumb-item active">不動產租賃</li>
                </ol>
            </div>
        </div>
    </div>

    <!-- 統計卡片 -->
    <div class="row mb-4">
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-dark shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-dark text-uppercase mb-1">
                                總租賃面積
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">7,500 坪</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-building fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-success shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                                月租金收入
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">NT$ 13,500,000</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-dollar-sign fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-info shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-info text-uppercase mb-1">
                                出租率
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">95.2%</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-chart-pie fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-warning shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                                即將到期合約
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">0</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-clock fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 不動產租賃清單 -->
    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-dark">不動產租賃清單</h6>
            <div>
                <button class="btn btn-dark btn-sm me-2">
                    <i class="fas fa-plus me-1"></i>新增租賃
                </button>
                <button class="btn btn-success btn-sm">
                    <i class="fas fa-file-excel me-1"></i>匯出Excel
                </button>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>編號</th>
                            <th>承租人</th>
                            <th>物件類型</th>
                            <th>地址</th>
                            <th>樓地板面積</th>
                            <th>月租金</th>
                            <th>租期</th>
                            <th>押金</th>
                            <th>狀態</th>
                            <th>租期開始</th>
                            <th>租期結束</th>
                            <th>操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td>
                                    <strong>@item.LesseeName</strong>
                                </td>
                                <td>
                                    <span class="badge bg-dark">@item.PropertyType</span>
                                </td>
                                <td>
                                    <small>@item.Address</small>
                                </td>
                                <td class="text-center">
                                    @item.FloorArea.ToString("N0") 坪
                                </td>
                                <td class="text-end">
                                    <strong>NT$ @item.MonthlyRent.ToString("N0")</strong>
                                </td>
                                <td class="text-center">
                                    @item.LeasePeriod 個月
                                </td>
                                <td class="text-end">
                                    NT$ @item.Deposit.ToString("N0")
                                </td>
                                <td>
                                    @if (item.Status == "租賃中")
                                    {
                                        <span class="badge bg-success">@item.Status</span>
                                    }
                                    else if (item.Status == "已到期")
                                    {
                                        <span class="badge bg-secondary">@item.Status</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">@item.Status</span>
                                    }
                                </td>
                                <td>@item.LeaseStartDate.ToString("yyyy/MM/dd")</td>
                                <td>
                                    @if (item.LeaseEndDate <= DateTime.Now.AddMonths(3))
                                    {
                                        <span class="text-warning">
                                            <i class="fas fa-clock me-1"></i>
                                            @item.LeaseEndDate.ToString("yyyy/MM/dd")
                                        </span>
                                    }
                                    else
                                    {
                                        <span>@item.LeaseEndDate.ToString("yyyy/MM/dd")</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group">
                                        <button type="button" class="btn btn-sm btn-outline-primary" 
                                                onclick="viewDetails(@item.Id)" title="查看詳細">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-success" 
                                                onclick="viewRentHistory(@item.Id)" title="租金記錄">
                                            <i class="fas fa-history"></i>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-info" 
                                                onclick="viewPropertyDetails(@item.Id)" title="物件詳情">
                                            <i class="fas fa-home"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- 地圖和分析 -->
    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-dark">物件分布地圖</h6>
                </div>
                <div class="card-body">
                    <div id="propertyMap" style="height: 400px; background-color: #f8f9fc; border: 1px solid #e3e6f0; border-radius: 5px;">
                        <div class="d-flex justify-content-center align-items-center h-100">
                            <div class="text-center">
                                <i class="fas fa-map fa-3x text-muted mb-3"></i>
                                <p class="text-muted">物件地圖顯示區域</p>
                                <small class="text-muted">整合 Google Maps API 顯示租賃物件位置</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-dark">物件類型分析</h6>
                </div>
                <div class="card-body">
                    <canvas id="propertyTypeChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .border-left-dark {
        border-left: 0.25rem solid #343a40 !important;
    }
    .border-left-success {
        border-left: 0.25rem solid #1cc88a !important;
    }
    .border-left-info {
        border-left: 0.25rem solid #36b9cc !important;
    }
    .border-left-warning {
        border-left: 0.25rem solid #f6c23e !important;
    }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // 物件類型分析圖表
        const propertyTypeCtx = document.getElementById('propertyTypeChart').getContext('2d');
        const propertyTypeChart = new Chart(propertyTypeCtx, {
            type: 'doughnut',
            data: {
                labels: ['商業大樓', '工業廠房', '住宅大樓', '商場'],
                datasets: [{
                    data: [1, 1, 0, 0],
                    backgroundColor: [
                        '#343a40',
                        '#1cc88a',
                        '#36b9cc',
                        '#f6c23e'
                    ]
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom'
                    }
                }
            }
        });

        // 功能按鈕事件
        function viewDetails(id) {
            alert('查看不動產租賃詳細資料 ID: ' + id);
        }

        function viewRentHistory(id) {
            alert('查看租金記錄 ID: ' + id);
        }

        function viewPropertyDetails(id) {
            alert('查看物件詳情 ID: ' + id);
        }
    </script>
}